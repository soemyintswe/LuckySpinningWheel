rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function approved() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true; }

    match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'participant' && request.resource.data.approved == false;
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','contact','address','payment','avatarUrl','updatedAt']));
      allow delete: if false;
    }
    match /raffles/{raffleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      match /spinAttempts/{attemptId} {
        allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
        allow write: if false;
      }
    }
    match /participants/{entryId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if (approved() || isAdmin()) && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.ticketCount is int && request.resource.data.ticketCount > 0 && request.resource.data.ticketCount <= 100;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /donations/{donationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if (approved() || isAdmin()) && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }
    match /winners/{winnerId} { allow read: if true; allow write: if false; }
    match /ledger/{entryId} {
      allow read, write: if isAdmin();
    }
  }
}
