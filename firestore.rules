rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    function accountActive() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (!('status' in userDoc(request.auth.uid).data) || userDoc(request.auth.uid).data.status == 'active'); }
    function approved() { return accountActive() && userDoc(request.auth.uid).data.approved == true; }
    function raffle(raffleId) { return get(/databases/$(database)/documents/raffles/$(raffleId)); }
    function raffleAfter(raffleId) { return getAfter(/databases/$(database)/documents/raffles/$(raffleId)); }
    function raffleMode(raffleId) { return 'entryMode' in raffle(raffleId).data ? raffle(raffleId).data.entryMode : 'free'; }
    function beforeRaffleClose(data) { return !("closeAtTimestamp" in data) || data.closeAtTimestamp == null || request.time <= data.closeAtTimestamp; }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update: if admin() && uid != request.auth.uid && exists(/databases/$(database)/documents/users/$(uid)) && userDoc(uid).data.approved == true && request.resource.data.role == 'admin';
      allow delete: if admin() && uid != request.auth.uid;
    }
    match /paymentOptions/{optionId} {
      allow read: if true;
      allow create: if admin() && request.resource.data.type in ['bank','wallet'] && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50;
      allow update: if admin() && request.resource.data.type in ['bank','wallet'] && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50;
      allow delete: if admin();
    }
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'participant' && request.resource.data.approved == false && request.resource.data.status == 'active' && request.resource.data.pointsBalance == 0;
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow update: if admin() || (accountActive() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','contact','telegram','address','payment','avatarUrl','updatedAt']));
      allow delete: if false;
    }
    match /raffles/{raffleId} {
      allow read: if true;
      allow create, delete: if admin();
      allow update: if admin()
        || (signedIn() && approved()
          && existsAfter(/databases/$(database)/documents/participants/$(request.auth.uid + '_' + raffleId))
          && getAfter(/databases/$(database)/documents/participants/$(request.auth.uid + '_' + raffleId)).data.raffleId == raffleId
          && getAfter(/databases/$(database)/documents/participants/$(request.auth.uid + '_' + raffleId)).data.userId == request.auth.uid
          && getAfter(/databases/$(database)/documents/participants/$(request.auth.uid + '_' + raffleId)).data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reservedTicketCount'])
          && request.resource.data.reservedTicketCount == (('reservedTicketCount' in resource.data) ? resource.data.reservedTicketCount : resource.data.ticketCount) + getAfter(/databases/$(database)/documents/participants/$(request.auth.uid + '_' + raffleId)).data.ticketCount
          && request.resource.data.reservedTicketCount <= resource.data.maxTickets)
        || (signedIn() && approved()
          && resource.data.status in ['active','scheduled']
          && request.time >= resource.data.openAtTimestamp
          && (resource.data.drawAtTimestamp == null || request.time >= resource.data.drawAtTimestamp)
          && beforeRaffleClose(resource.data)
          && resource.data.drawSpinsUsed < resource.data.ticketCount
          && resource.data.remainingPrizeCount is int
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['drawSpinsUsed','drawLocked','lastSpinEntryId','lastSpinAttemptId','remainingPrizeCount','status','closedAtTimestamp'])
          && request.resource.data.drawSpinsUsed == resource.data.drawSpinsUsed + 1
          && request.resource.data.drawLocked == true
          && existsAfter(/databases/$(database)/documents/raffles/$(raffleId)/spinAttempts/$(request.resource.data.lastSpinAttemptId))
          && getAfter(/databases/$(database)/documents/raffles/$(raffleId)/spinAttempts/$(request.resource.data.lastSpinAttemptId)).data.actorId == request.auth.uid
          && getAfter(/databases/$(database)/documents/raffles/$(raffleId)/spinAttempts/$(request.resource.data.lastSpinAttemptId)).data.raffleId == raffleId
          && getAfter(/databases/$(database)/documents/raffles/$(raffleId)/spinAttempts/$(request.resource.data.lastSpinAttemptId)).data.entryId == request.resource.data.lastSpinEntryId
          && request.resource.data.remainingPrizeCount == resource.data.remainingPrizeCount - (getAfter(/databases/$(database)/documents/raffles/$(raffleId)/spinAttempts/$(request.resource.data.lastSpinAttemptId)).data.won ? 1 : 0)
          && request.resource.data.remainingPrizeCount >= 0
          && ((request.resource.data.remainingPrizeCount == 0 && request.resource.data.status == 'closed' && request.resource.data.closedAtTimestamp is timestamp)
            || (request.resource.data.remainingPrizeCount > 0 && request.resource.data.status == resource.data.status && !('closedAtTimestamp' in request.resource.data.diff(resource.data).affectedKeys())))
          && existsAfter(/databases/$(database)/documents/participants/$(request.resource.data.lastSpinEntryId))
          && get(/databases/$(database)/documents/participants/$(request.resource.data.lastSpinEntryId)).data.status == 'approved'
          && get(/databases/$(database)/documents/participants/$(request.resource.data.lastSpinEntryId)).data.spinsUsed < get(/databases/$(database)/documents/participants/$(request.resource.data.lastSpinEntryId)).data.ticketCount
          && getAfter(/databases/$(database)/documents/participants/$(request.resource.data.lastSpinEntryId)).data.spinsUsed == get(/databases/$(database)/documents/participants/$(request.resource.data.lastSpinEntryId)).data.spinsUsed + 1
          && getAfter(/databases/$(database)/documents/participants/$(request.resource.data.lastSpinEntryId)).data.raffleId == raffleId
          && (!('drawController' in resource.data) || resource.data.drawController in ['participant','both']));
      match /prizeSlots/{slotId} { allow read: if true; allow create, update, delete: if admin() && existsAfter(/databases/$(database)/documents/raffles/$(raffleId)) && getAfter(/databases/$(database)/documents/raffles/$(raffleId)).data.drawLocked != true; }
      match /claimedSlots/{slotId} {
        allow read: if admin() || signedIn();
        allow create: if signedIn() && !exists(/databases/$(database)/documents/raffles/$(raffleId)/claimedSlots/$(slotId)) && existsAfter(/databases/$(database)/documents/raffles/$(raffleId)/prizeSlots/$(slotId)) && existsAfter(/databases/$(database)/documents/winners/$(request.resource.data.winnerId)) && getAfter(/databases/$(database)/documents/winners/$(request.resource.data.winnerId)).data.prizeSlotId == slotId && getAfter(/databases/$(database)/documents/winners/$(request.resource.data.winnerId)).data.raffleId == raffleId && request.resource.data.userId == getAfter(/databases/$(database)/documents/winners/$(request.resource.data.winnerId)).data.winnerId && (admin() || getAfter(/databases/$(database)/documents/winners/$(request.resource.data.winnerId)).data.winnerId == request.auth.uid);
        allow update, delete: if false;
      }
      match /spinAttempts/{attemptId} {
        allow read: if admin() || (accountActive() && resource.data.userId == request.auth.uid);
        allow create: if signedIn() && request.resource.data.actorId == request.auth.uid && request.resource.data.entryId is string && existsAfter(/databases/$(database)/documents/participants/$(request.resource.data.entryId)) && getAfter(/databases/$(database)/documents/participants/$(request.resource.data.entryId)).data.spinsUsed == get(/databases/$(database)/documents/participants/$(request.resource.data.entryId)).data.spinsUsed + 1 && request.resource.data.userId == getAfter(/databases/$(database)/documents/participants/$(request.resource.data.entryId)).data.userId && request.resource.data.raffleId == raffleId && raffleAfter(raffleId).data.lastSpinAttemptId == attemptId && raffleAfter(raffleId).data.remainingPrizeCount == raffle(raffleId).data.remainingPrizeCount - (request.resource.data.won ? 1 : 0) && (!request.resource.data.won || (existsAfter(/databases/$(database)/documents/raffles/$(raffleId)/claimedSlots/$(request.resource.data.slotId)) && getAfter(/databases/$(database)/documents/raffles/$(raffleId)/claimedSlots/$(request.resource.data.slotId)).data.attemptId == attemptId && getAfter(/databases/$(database)/documents/raffles/$(raffleId)/claimedSlots/$(request.resource.data.slotId)).data.winnerId == request.resource.data.winnerId && existsAfter(/databases/$(database)/documents/winners/$(request.resource.data.winnerId))));
        allow update, delete: if false;
      }
    }
    match /participants/{entryId} {
      allow read: if admin() || (accountActive() && (entryId.matches('^' + request.auth.uid + '_.*$') || resource.data.userId == request.auth.uid));
      allow create: if (approved() || admin()) && request.resource.data.userId == request.auth.uid && entryId == request.auth.uid + '_' + request.resource.data.raffleId && request.resource.data.status == 'pending' && request.resource.data.ticketCount is int && request.resource.data.ticketCount > 0 && request.resource.data.ticketCount <= 100 && request.resource.data.spinsUsed == 0 && request.resource.data.raffleId is string && exists(/databases/$(database)/documents/raffles/$(request.resource.data.raffleId)) && raffle(request.resource.data.raffleId).data.status in ['active','scheduled'] && request.time >= raffle(request.resource.data.raffleId).data.openAtTimestamp && (raffle(request.resource.data.raffleId).data.drawAtTimestamp == null || request.time < raffle(request.resource.data.raffleId).data.drawAtTimestamp) && beforeRaffleClose(raffle(request.resource.data.raffleId).data) && (('reservedTicketCount' in raffle(request.resource.data.raffleId).data) ? raffle(request.resource.data.raffleId).data.reservedTicketCount : raffle(request.resource.data.raffleId).data.ticketCount) + request.resource.data.ticketCount <= raffle(request.resource.data.raffleId).data.maxTickets && request.resource.data.ticketCount <= (('maxTicketsPerUser' in raffle(request.resource.data.raffleId).data) ? raffle(request.resource.data.raffleId).data.maxTicketsPerUser : (raffleMode(request.resource.data.raffleId) == 'paid' ? raffle(request.resource.data.raffleId).data.maxTickets : 1)) && getAfter(/databases/$(database)/documents/raffles/$(request.resource.data.raffleId)).data.reservedTicketCount == (('reservedTicketCount' in raffle(request.resource.data.raffleId).data) ? raffle(request.resource.data.raffleId).data.reservedTicketCount : raffle(request.resource.data.raffleId).data.ticketCount) + request.resource.data.ticketCount && request.resource.data.entryMode == raffleMode(request.resource.data.raffleId);
      allow update: if admin() || (signedIn() && approved() && resource.data.userId == request.auth.uid && resource.data.status == 'approved' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['spinsUsed']) && request.resource.data.spinsUsed == resource.data.spinsUsed + 1 && request.resource.data.spinsUsed <= resource.data.ticketCount && raffleAfter(resource.data.raffleId).data.drawSpinsUsed == raffle(resource.data.raffleId).data.drawSpinsUsed + 1 && raffleAfter(resource.data.raffleId).data.lastSpinEntryId == entryId);
      allow delete: if admin();
    }
    match /donations/{donationId} {
      allow read: if admin() || (accountActive() && resource.data.userId == request.auth.uid);
      allow create: if (approved() || admin()) && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      allow update, delete: if admin();
    }
    match /winners/{winnerId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.deliveryStatus == 'pending' && existsAfter(/databases/$(database)/documents/raffles/$(request.resource.data.raffleId)/claimedSlots/$(request.resource.data.prizeSlotId)) && getAfter(/databases/$(database)/documents/raffles/$(request.resource.data.raffleId)/claimedSlots/$(request.resource.data.prizeSlotId)).data.winnerId == winnerId && existsAfter(/databases/$(database)/documents/raffles/$(request.resource.data.raffleId)/spinAttempts/$(request.resource.data.attemptId)) && getAfter(/databases/$(database)/documents/raffles/$(request.resource.data.raffleId)/spinAttempts/$(request.resource.data.attemptId)).data.winnerId == winnerId && getAfter(/databases/$(database)/documents/raffles/$(request.resource.data.raffleId)/spinAttempts/$(request.resource.data.attemptId)).data.won == true && (admin() || request.resource.data.winnerId == request.auth.uid);
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryStatus','deliveryHistory','updatedAt','ownerUid','ownerName','ownerImage','transferEmail']) && request.resource.data.deliveryHistory.size() == resource.data.deliveryHistory.size() + 1 && request.resource.data.deliveryStatus in ['delivered','reclaimed','donated','transferred'];
      allow delete: if false;
    }
    match /prizeRequests/{requestId} {
      allow read: if admin() || (accountActive() && resource.data.requesterUid == request.auth.uid);
      allow create: if approved() && request.resource.data.requesterUid == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.type in ['donation','transfer'] && exists(/databases/$(database)/documents/winners/$(request.resource.data.winnerId)) && get(/databases/$(database)/documents/winners/$(request.resource.data.winnerId)).data.deliveryStatus == 'pending' && (('ownerUid' in get(/databases/$(database)/documents/winners/$(request.resource.data.winnerId)).data) && get(/databases/$(database)/documents/winners/$(request.resource.data.winnerId)).data.ownerUid == request.auth.uid || get(/databases/$(database)/documents/winners/$(request.resource.data.winnerId)).data.winnerId == request.auth.uid);
      allow update: if admin() && resource.data.status == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt']) && request.resource.data.status in ['approved','rejected'];
      allow delete: if false;
    }
    match /ledger/{entryId} {
      allow read, create: if admin();
      // Financial journal rows are append-only; corrections use a new reversing entry.
      allow update, delete: if false;
    }
    match /pointLedger/{entryId} { allow read, write: if admin(); }
  }
}
